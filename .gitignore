# The assembled build root is regenerated by scripts/build-graph.sh — don't commit it.
build-root/

# Keep the built graph (graphify-out/) committed — it's what the MCP serves.
# Graphify's cache: keep ONLY the semantic cache (small: ~0.6 MB of extracted nodes/edges, no
# document text). It is the seed that lets a fresh checkout (the nightly CI run) re-extract only
# what changed. The AST cache embeds absolute build paths and is never committed.
graphify-out/cache/*
!graphify-out/cache/semantic-deep/

# OS / editor cruft
.DS_Store
__pycache__/
*.pyc
metrics-data/

# deep-read intermediate artifacts (regenerable)
graphify-out/.deep_read_*.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_build.json
graphify-out/.graphify_semantic_marker
graphify-out/.graphify_root
graphify-out/20*/
nightly-work/
