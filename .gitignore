# The assembled build root is regenerated by scripts/build-graph.sh — don't commit it.
build-root/

# Keep the built graph (graphify-out/) committed — it's what the MCP serves.
# But ignore Graphify's incremental cache.
graphify-out/cache/

# OS / editor cruft
.DS_Store
__pycache__/
*.pyc
metrics-data/

# deep-read intermediate artifacts (regenerable)
graphify-out/.deep_read_*.json
